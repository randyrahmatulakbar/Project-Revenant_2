[node name="SensBox" type="HBoxContainer" parent="Panel/Margin/VBox/Scroll/Content/GameGrid"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="SensSlider" type="HSlider" parent="Panel/Margin/VBox/Scroll/Content/GameGrid/SensBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(180, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
min_value = 0.1
max_value = 3.0
step = 0.05
value = 1.0

[node name="SensValue" type="Label" parent="Panel/Margin/VBox/Scroll/Content/GameGrid/SensBox"]
