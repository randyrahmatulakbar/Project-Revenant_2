[gd_scene format=3]

[ext_resource type="Script" path="res://settings_menu.gd" id="1_settings"]

[node name="SettingsMenu" type="CenterContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")

[node name="Panel" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(560, 600)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
theme_override_font_sizes/font_size = 36
text = "SETTINGS"
horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Panel/Margin/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="GameplayHeader" type="HBoxContainer" parent="Panel/Margin/VBox/Scroll/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Panel/Margin/VBox/Scroll/Content/GameplayHeader"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.72, 0.27, 1)
text = "// GAMEPLAY"

[node name="Line" type="HSeparator" parent="Panel/Margin/VBox/Scroll/Content/GameplayHeader"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4

[node name="GameGrid" type="GridContainer" parent="Panel/Margin/VBox/Scroll/Content"]
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 12
columns = 2

[node name="SensLabel" type="Label" parent="Panel/Margin/VBox/Scroll/Content/GameGrid"]
